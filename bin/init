#!/bin/sh

set -x
set -e

# check & gen ssl certificate
if [ ! -e "${SSL_CERTFILE}" ] || [ ! -e "${SSL_KEYFILE}" ]; then
  openssl req -newkey rsa:2048 -sha256 -nodes -x509 -days 365 -subj "/O=ElectrumX" -keyout "${SSL_KEYFILE}" -out "${SSL_CERTFILE}"
fi

# check and init tx db
if [ ! -e "${MARIADB}" ]; then

    mariadb-install-db --datadir=${MARIADB}

    # start mariadbd; for portainer we must use root user. *sigh*
    /usr/bin/mariadbd-safe --datadir=${MARIADB} --user=root &
    sleep 5

    # Create the tx db from the same EX_*_PASS the parser and view scripts
    # connect with, so a password lives in one place.
    # Tracing off: set -x would echo the passwords into the container log.
    set +x
    if [ -z "${EX_WRITER_PASS}" ] || [ -z "${EX_READER_PASS}" ]; then
        echo "ERROR: EX_WRITER_PASS and EX_READER_PASS must be set to create"
        echo "       the tx database.  ex_admin is added if EX_ADMIN_PASS is set."
        exit 1
    fi

    # '' is the sql escape for ', and mariadb also treats \ as an escape
    sql_quote() {
        printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e "s/'/''/g"
    }

    {
        echo "create database if not exists \`electrumx_transactions\`"
        echo "  CHARACTER SET utf8 COLLATE utf8_general_ci;"

        # localhost, not '%': we reach mariadb over this container's unix socket
        printf "create user if not exists 'ex_writer'@'localhost' identified by '%s';\n" \
            "$(sql_quote "${EX_WRITER_PASS}")"
        echo "grant SELECT,INSERT,UPDATE,DELETE,LOCK TABLES on electrumx_transactions.* to 'ex_writer'@'localhost';"

        printf "create user if not exists 'ex_reader'@'localhost' identified by '%s';\n" \
            "$(sql_quote "${EX_READER_PASS}")"
        echo "grant SELECT on electrumx_transactions.* to 'ex_reader'@'localhost';"

        if [ -n "${EX_ADMIN_PASS:-}" ]; then
            printf "create user if not exists 'ex_admin'@'localhost' identified by '%s';\n" \
                "$(sql_quote "${EX_ADMIN_PASS}")"
            echo "grant SELECT,INSERT,UPDATE,DELETE,CREATE,DROP,ALTER on electrumx_transactions.* to 'ex_admin'@'localhost';"
        fi

        cat <<'SCHEMA'
use `electrumx_transactions`;
create table if not exists `transaction` (
	`id` int(11) NOT NULL AUTO_INCREMENT,
	`received_time` TIMESTAMP not null,
	`tx_id` char(64) not null,
	`size` INT not null,
	`vsize` INT not null,
	`vin_count` INT not null,
	`vout_count` INT not null,
	`value` DECIMAL(16,8) not null,
	`ip_addr` VARCHAR(31),
	`port` INT,

	PRIMARY KEY (`id`)
) ENGINE=INNODB AUTO_INCREMENT=1 ;
SCHEMA
    } | mariadb -u root
    set -x

    echo "tx database created; credentials taken from EX_*_PASS"

else

    # start mariadbd; for portainer we must use root user. *sigh*
    /usr/bin/mariadbd-safe --datadir=${MARIADB} --user=root &
    sleep 5

fi

# get public ip to publicize our service
#IP=`wget -qO- ifconfig.me`
IP=`curl ifconfig.me`
export REPORT_SERVICES=ssl://$IP:50002
echo REPORT_SERVICES : $REPORT_SERVICES

# ElectrumX packs its history flush counter into a uint16, so at 65,536 it
# starts dying on every flush with
#   struct.error: 'H' format requires 0 <= number <= 65535
# Only electrumx_compact_history resets the counter, and it needs the server
# stopped -- which is exactly where we are right now.  So check the counter on
# every start and compact before the overflow instead of after it.
#
# We do not wait for a scheduled reboot to get here: electrumx-tx-parser.py
# watches electrumx's own "flush #N" logging and stops the server once N passes
# this same threshold, so the restart that lands us here happens exactly when a
# compaction is due.  One number drives both, so a restart always arrives at a
# boot that compacts.
#
# 60,000 leaves ~5,500 flushes of headroom below the 65,535 ceiling, which is
# ample for a clean shutdown.  Don't lower it to force more frequent
# compaction: _compact_history walks the whole address keyspace, so every run
# rewrites the entire history DB no matter what the counter says.
# Compaction can take a few hours on a full mainnet history; it is resumable.
COMPACT_AT_FLUSH_COUNT=${COMPACT_AT_FLUSH_COUNT:-60000}
flush_count=`history-flush-count.py`
echo "history flush count: $flush_count (compaction threshold: $COMPACT_AT_FLUSH_COUNT)"
if [ "$flush_count" -ge "$COMPACT_AT_FLUSH_COUNT" ]; then
    echo "compacting history DB to reset the flush counter ..."
    /electrumx/electrumx_compact_history

    # electrumx_compact_history catches its own exceptions and still exits 0
    # (e.g. when COIN is unset, which it requires despite what its docstring
    # says), so trust the counter rather than the exit status.  Starting the
    # server with the counter still at the ceiling just crashes it on the
    # first flush, which is the failure we are here to avoid.
    flush_count=`history-flush-count.py`
    echo "history flush count is now $flush_count"
    if [ "$flush_count" -ge "$COMPACT_AT_FLUSH_COUNT" ]; then
        echo "ERROR: compaction did not reset the flush counter -- refusing to"
        echo "       start, since the server would die at its first flush."
        exit 1
    fi
fi

# start sql monitor service
/usr/local/bin/monitor-sql.sh&
sleep 2

# keep one previous log; below the threshold, append instead, so that a couple
# of short runs cannot push the interesting log out
LOG_FILE=${LOG_FILE:-/data/js-electrumx.log}
LOG_MIN_ROTATE_BYTES=${LOG_MIN_ROTATE_BYTES:-10485760}
if [ -e "$LOG_FILE" ]; then
    log_size=$(($(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)))
    if [ "$log_size" -gt "$LOG_MIN_ROTATE_BYTES" ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1"
        echo "rotated previous log ($log_size bytes) to $LOG_FILE.1"
    fi
fi

# run electrumx server
/electrumx/electrumx_server 2>&1 \
    | electrumx-tx-parser.py 2>&1 \
    | tee -a "$LOG_FILE"
